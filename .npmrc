# @geniemarketing/* packages resolve from the org's GitHub Packages registry.
# AUTH IS NOT COMMITTED HERE. pnpm >=10.34 won't expand env-var tokens from a
# committed project .npmrc, so the token is supplied from a trusted user-level
# ~/.npmrc instead:
#   - CI (Amplify): written in amplify.yml preBuild from the NODE_AUTH_TOKEN env var.
#   - Locally: add `//npm.pkg.github.com/:_authToken=<PAT with read:packages>` to ~/.npmrc.
@geniemarketing:registry=https://npm.pkg.github.com
auto-install-peers=true
